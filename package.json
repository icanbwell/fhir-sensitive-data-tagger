{
  "name": "@icanbwell/fhir-sensitive-data-tagger",
  "version": "1.0.0",
  "description": "Fhir Sensitive Data Tagging Package",
  "keywords": [
    "fhir",
    "sensitive-data-tagging",
    "fhir-sensitive-data-tagging"
  ],
  "homepage": "https://github.com/icanbwell/fhir-sensitive-data-tagger#readme",
  "bugs": {
    "url": "https://github.com/icanbwell/fhir-sensitive-data-tagger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icanbwell/fhir-sensitive-data-tagger.git"
  },
  "license": "MIT",
  "author": "Nirbhay Kumar Nachiketa",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run clean:dist && tsup src/index.ts --format cjs,esm --dts && npm run check:cjs-import && npm run check:esm-import && npm run check:ts-import",
    "build:watch": "npm run clean:dist && tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "npm run clean:all",
    "clean:all": "npm run clean:dist && npm run clean:coverage && npm run clean:deps",
    "clean:dist": "rm -rf ./dist/",
    "clean:coverage": "rm -rf ./coverage/",
    "clean:deps": "rm -rf ./node_modules/",
    "clean:cache": "npm cache clean --force",
    "prebuild": "npm run clean:dist",
    "pretest": "npm run clean:coverage",
    "lint": "eslint ./src/ ./tests/ --ext .ts --fix",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "test:watch": "jest --watch",
    "test": "jest --coverage --testPathIgnorePatterns=tests_integration/",
    "test:integration": "jest tests_integration",
    "typecheck": "tsc --noEmit",
    "check:cjs-import": "node tests/build/cjs-import-check.cjs",
    "check:esm-import": "node --experimental-vm-modules tests/build/esm-import-check.mjs",
    "check:ts-import": "ts-node --project tsconfig.json tests/build/ts-import-check.ts",
    "split:bundle": "node tests/full_record/split_bundle.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-failure-reporter": "^1.0.1",
    "jest-util": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "lint-staged": {
    "src/**/*.{ts,js}": "yarn eslint --cache --cache-location .eslintcache --fix",
    "test/!(build)/**/*.{ts,js}": "yarn eslint --cache --cache-location .eslintcache --fix"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "build",
                "section": "Dependencies and Other Build Updates",
                "hidden": false
              }
            ]
          }
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
